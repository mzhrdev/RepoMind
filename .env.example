# RepoMind configuration
#
# RepoMind talks to Ollama's HTTP API. Choose ONE of the profiles below by
# copying this file to .env and uncommenting the lines you want.

# Request timeout for model calls, in seconds (applies to all profiles).
REPOMIND_TIMEOUT=120

# --- Profile A: Local model (default) --------------------------------------
# Runs entirely on your machine. No API key needed. Download the model first:
#   ollama pull qwen2.5-coder:3b
OLLAMA_HOST=http://localhost:11434
REPOMIND_MODEL=qwen2.5-coder:3b

# --- Profile B: Cloud via local Ollama (recommended on weak hardware) ------
# Sign in once with `ollama signin`, then use a model name ending in :cloud.
# The local Ollama proxies the request to the cloud; no API key variable needed.
#   OLLAMA_HOST=http://localhost:11434
#   REPOMIND_MODEL=gemma4:cloud

# --- Profile C: Cloud direct to ollama.com ---------------------------------
# Calls https://ollama.com directly. Requires an API key from
# https://ollama.com/settings/keys. Use the cloud model's API name (e.g. the
# name returned by `curl https://ollama.com/api/tags`).
#   OLLAMA_HOST=https://ollama.com
#   REPOMIND_MODEL=gemma4:31b
#   OLLAMA_API_KEY=your_api_key_here
